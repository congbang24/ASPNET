@model Day6_NguyenCongBang_baitap.Models.Movie

@{
    ViewData["Title"] = "Create Movie";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create Movie</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Title</label>
                            <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề phim..." />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <!-- Date -->
                        <div class="mb-3">
                            <label asp-for="ReleaseDate" class="form-label fw-bold">Date</label>
                            <input asp-for="ReleaseDate" type="date" class="form-control" />
                            <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                        </div>

                        <!-- Duration -->
                        <div class="mb-3">
                            <label asp-for="Duration" class="form-label fw-bold">Duration</label>
                            <input asp-for="Duration" type="number" class="form-control" placeholder="Thời lượng (phút)..." />
                            <span asp-validation-for="Duration" class="text-danger"></span>
                        </div>

                        <!-- Genre -->
                        <div class="mb-3">
                            <label asp-for="GenreId" class="form-label fw-bold">Genre</label>
                            <select asp-for="GenreId" class="form-select" asp-items="ViewBag.GenreId">
                                <option value="">-- Chọn thể loại phim --</option>
                            </select>
                            <span asp-validation-for="GenreId" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                            <button type="submit" class="btn btn-primary">Create</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
