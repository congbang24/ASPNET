@model IEnumerable<Day6_NguyenCongBang_baitap.Models.Movie>

@{
    ViewData["Title"] = "Movie List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Movie List</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </div>

    <table class="table table-bordered table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th style="width: 80px;">Id</th>
                <th>Title</th>
                <th>Date</th>
                <th>Genre</th>
                <th>Duration (phút)</th>
                <th style="width: 220px;" class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td class="fw-bold">@item.Title</td>
                    <td>@item.ReleaseDate.ToString("yyyy") (@item.ReleaseDate.ToString("dd/MM/yyyy"))</td>
                    <td>
                        <span class="badge bg-info text-dark fs-6">
                            @(item.Genre != null ? item.Genre.Name : "Chưa phân loại")
                        </span>
                    </td>
                    <td>@item.Duration</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Chưa có bộ phim nào. Nhấn "Create New" để thêm mới!</td>
            </tr>
        }
        </tbody>
    </table>
</div>
