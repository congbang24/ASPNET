@model (string FullName, string Role, string Note)

<div class="card shadow-sm border-info mb-3">
    <div class="card-header bg-info text-white">
        <strong>🧩 Demo Partial View</strong>
    </div>
    <div class="card-body">
        <h5 class="card-title text-primary">Họ và tên: @Model.FullName</h5>
        <h6 class="card-subtitle mb-2 text-muted">Vai trò: @Model.Role</h6>
        <p class="card-text">@Model.Note</p>
        <span class="badge bg-secondary">Cơ chế: Dữ liệu này được truyền trực tiếp từ View cha vào Partial View.</span>
    </div>
</div>
