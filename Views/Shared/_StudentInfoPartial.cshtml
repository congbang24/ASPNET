@model (string FullName, string Role, string Note)

<div class="card shadow-sm border mb-3">
    <div class="card-header bg-light text-dark fw-semibold">
        🧩 Partial View
    </div>
    <div class="card-body">
        <h6 class="card-title text-dark fw-bold mb-1">@Model.FullName</h6>
        <div class="text-muted small mb-2">@Model.Role</div>
        <p class="card-text text-secondary mb-2">@Model.Note</p>
        <span class="badge bg-light text-secondary border">Cơ chế: Dữ liệu truyền từ View cha</span>
    </div>
</div>
