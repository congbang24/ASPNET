@model List<string>

<div class="card shadow-sm border mb-3">
    <div class="card-header bg-light text-dark d-flex justify-content-between align-items-center fw-semibold">
        <span>⚙️ ViewComponent</span>
        <span class="badge bg-secondary-subtle text-secondary border small">@ViewBag.ServerTime</span>
    </div>
    <div class="card-body">
        <h6 class="card-title text-dark fw-bold mb-2">@ViewBag.ComponentTitle</h6>
        <p class="card-text text-secondary small mb-2">
            Class C# tự xử lý logic và dữ liệu độc lập:
        </p>
        <ul class="list-group list-group-flush mb-3 small">
            @foreach (var course in Model)
            {
                <li class="list-group-item px-0 py-1 text-secondary">
                    • @course
                </li>
            }
        </ul>
        <span class="badge bg-light text-secondary border">Cơ chế: Tự xử lý logic độc lập trong C#</span>
    </div>
</div>
