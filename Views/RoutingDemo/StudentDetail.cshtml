@{
    ViewData["Title"] = "Chi tiết sinh viên - Attribute Routing";
}

<div class="card shadow-sm border-success mt-4">
    <div class="card-header bg-success text-white">
        <h4>🎯 Kết quả nhận được từ Attribute Routing</h4>
    </div>
    <div class="card-body">
        <p class="lead">Action này được kích hoạt thông qua template định tuyến: <code>[HttpGet("sinh-vien/{id:int}/{ten}")]</code></p>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">URL đang chạy:</dt>
            <dd class="col-sm-9"><span class="badge bg-dark fs-6">@ViewBag.CurrentUrl</span></dd>

            <dt class="col-sm-3">Mã số (ID):</dt>
            <dd class="col-sm-9"><span class="badge bg-primary fs-6">@ViewBag.Id</span></dd>

            <dt class="col-sm-3">Tên sinh viên:</dt>
            <dd class="col-sm-9"><span class="badge bg-info text-dark fs-6">@ViewBag.StudentName</span></dd>
        </dl>
        <a href="/dieu-huong-attribute" class="btn btn-outline-secondary mt-3">← Quay lại trang so sánh Routing</a>
    </div>
</div>
