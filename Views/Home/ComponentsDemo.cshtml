@{
    ViewData["Title"] = "Demo 1: Partial View & ViewComponent";
}

<div class="mb-4">
    <h3 class="text-dark fw-bold mb-1">Yêu cầu 1: Partial View & ViewComponent</h3>
    <p class="text-muted small">So sánh cơ chế tái sử dụng giao diện trong ASP.NET Core MVC</p>
    <hr class="text-secondary opacity-25" />
</div>

<div class="row g-4">
    <!-- CỘT 1: DEMO PARTIAL VIEW -->
    <div class="col-md-6">
        <div class="border rounded p-3 bg-white h-100 shadow-sm">
            <h5 class="text-dark fw-semibold mb-2">1. Partial View (_StudentInfoPartial)</h5>
            <p class="text-secondary small mb-3">
                Là file Razor con nhận dữ liệu thụ động từ View cha truyền vào:
            </p>

            <div class="p-2 bg-light border rounded mb-3">
                <code class="text-dark small">&lt;partial name="_StudentInfoPartial" model='...' /&gt;</code>
            </div>

            <!-- GỌI PARTIAL VIEW -->
            <partial name="_StudentInfoPartial" model='("Nguyễn Công Bằng", "Sinh viên", "Thực hành buổi 2: ASP.NET Core MVC Components")' />
        </div>
    </div>

    <!-- CỘT 2: DEMO VIEWCOMPONENT -->
    <div class="col-md-6">
        <div class="border rounded p-3 bg-white h-100 shadow-sm">
            <h5 class="text-dark fw-semibold mb-2">2. ViewComponent (CourseSummary)</h5>
            <p class="text-secondary small mb-3">
                Có class C# riêng (<code>CourseSummaryViewComponent</code>) tự xử lý dữ liệu độc lập:
            </p>

            <div class="p-2 bg-light border rounded mb-3">
                <code class="text-dark small">&commat;await Component.InvokeAsync("CourseSummary")</code>
            </div>

            <!-- GỌI VIEWCOMPONENT -->
            @await Component.InvokeAsync("CourseSummary", new { title = "Các học phần đào tạo" })
        </div>
    </div>
</div>

<div class="card bg-light border mt-4">
    <div class="card-body py-3">
        <h6 class="fw-bold text-dark mb-2">📌 Tóm tắt lý thuyết:</h6>
        <ul class="mb-0 text-secondary small">
            <li><strong>Partial View:</strong> Thụ động, dùng để tái sử dụng HTML đơn giản, dữ liệu do View cha truyền vào.</li>
            <li><strong>ViewComponent:</strong> Chủ động, có logic C# riêng (hỗ trợ async, DI, kết nối DB), không phụ thuộc vào View cha.</li>
        </ul>
    </div>
</div>
